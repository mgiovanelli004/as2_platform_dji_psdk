repositories:
  # The upstream umdlife/psdk_ros2 repository is no longer maintained
  # (https://github.com/umdlife/psdk_ros2/issues/170): use the Aerostack2 fork.
  # For the Matrice 4 series / Manifold 3 (PSDK 3.18.0), point this to the
  # branch with the Manifold 3 support (feat/upgrade-psdk-v3.18.0-manifold3).
  psdk_ros2:
    type: git
    url: https://github.com/aerostack2/psdk_ros2.git
    version: main
